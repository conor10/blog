---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;
---

<a {...Astro.props} target="_blank" rel="noopener noreferrer"><slot /><span class="book-link-hint"> (opens in a new tab)</span></a>

<style>
  .book-link-hint {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
