---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostImages from '../components/PostImages.astro';
import PostCitation from '../components/PostCitation.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  image?: string;
  audio?: string;
}

const { title, description, date, tags = [], image, audio } = Astro.props;
---
<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={date}
  image={image}
>
  <article class="prose">
    <header>
      <h1>{title}</h1>
      <div class="post-meta">
        <FormattedDate date={date} />
        {tags.length > 0 && <span>·</span>}
        {tags.map((t) => (
          <a href={`/writing/?tag=${encodeURIComponent(t)}`} class="tag">{t}</a>
        ))}
      </div>
    </header>
    {audio && (
      <aside class="article-audio" aria-label="Audio version">
        <p><strong>Listen to this article</strong><br /><small>Narrated with an AI version of my voice.</small></p>
        <audio controls preload="none" aria-label={`Listen to ${title}`} src={audio}>
          <a href={audio}>Download the audio</a>
        </audio>
      </aside>
    )}
    <PostImages><slot /></PostImages>
    <PostCitation title={title} date={date} />
  </article>
</BaseLayout>

<style>
  .article-audio { margin: 1.5rem 0 2rem; padding: 1rem 1.25rem; border: 1px solid var(--border); border-radius: 8px; }
  .article-audio p { margin: 0 0 .75rem; }
  .article-audio small { color: var(--fg-muted); }
  .article-audio audio { width: 100%; display: block; }
</style>
